# Copy this file to .env.local and fill in values from a NON-PRODUCTION Supabase
# project. See docs/stripe-test-runbook.md. Never put live Stripe keys here.
# If NEXT_PUBLIC_SUPABASE_URL is left unset the app falls back to the PRODUCTION
# Monarch project, so always set it explicitly.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-TEST-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
MONARCH_ENCRYPTION_KEY=
